{
  "name": "ciyper",
  "productName": "Ciyper",
  "version": "1.0.0",
  "description": "A floating AI assistant for live job interviews",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.ciyper.app",
    "productName": "Ciyper",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "renderer.js",
      "sessions.js",
      "ciyper_home.html",
      "ciyper_session.html",
      "style.css",
      "prism.js",
      "session.png",
      "ciyper-logo.png",
      "ciyper-logo.ico",
      "package.json"
    ],
    "win": {
      "icon": "ciyper-logo.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ciyper",
      "artifactName": "${productName}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.18.0"
  }
}
