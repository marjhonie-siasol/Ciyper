{
  "name": "co-assist-ai",
  "productName": "Co-Assist AI",
  "version": "1.0.0",
  "description": "A floating AI copilot for live interviews and meetings",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.coassist.ai",
    "productName": "Co-Assist AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "renderer.js",
      "sessions.js",
      "co-assist_ai_landing.html",
      "co-assist_ai_session.html",
      "style.css",
      "prism.js",
      "session.png",
      "icon.png",
      "icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Co-Assist AI"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0"
  }
}
