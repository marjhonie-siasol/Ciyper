{
  "name": "ciyper",
  "productName": "Ciyper",
  "version": "1.1.0",
  "description": "A floating AI assistant for live job interviews",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.ciyper.app",
    "productName": "Ciyper",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/branding/ciyper-logo.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ciyper",
      "uninstallDisplayName": "Ciyper",
      "artifactName": "${productName}-Setup-v${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-v${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.18.0"
  }
}
